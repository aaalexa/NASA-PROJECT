# ==============================================================================
# Variables de entorno para Producción (https://api.moody-trends.earth) y Local
# Copia este archivo a `.env` antes de ejecutar `docker compose up -d --build`
# ==============================================================================

# Dominio público gestionado por Caddy (Let's Encrypt TLS automático)
# Para pruebas únicamente en local sin dominio público, puedes usar API_DOMAIN=:80
API_DOMAIN=api.moody-trends.earth

# Orígenes permitidos por CORS (separados por comas)
NASA_CORS_ORIGINS=https://moody-trends.earth,https://www.moody-trends.earth,https://api.moody-trends.earth,http://localhost:3000,http://localhost:5173

# Credenciales NASA Earthdata Login (para consultas OPeNDAP en vivo en memoria RAM)
# Nunca subas el archivo .env real a Git.
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# Configuración de rendimiento y caché en memoria RAM (0 archivos en disco)
UVICORN_WORKERS=2
NASA_CACHE_MEMORIA_MAX=128
NASA_OPENDAP_WORKERS=6
NASA_OPENDAP_TIMEOUT=60
NASA_MAX_DESCARGAS=2
NASA_MAX_PIXELES=20000

